<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:id="@+id/imageView_Faculty_photo"
        android:src="@drawable/faculty_image"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/textView_Faculty_name"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/imageView_Faculty_photo"
        android:textSize="30sp"
        android:layout_marginTop="10dp"
        android:text="Nitya D Dhagat"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/textView_Faculty_designation"
        android:layout_centerHorizontal="true"
        android:textSize="20sp"
        android:layout_below="@id/textView_Faculty_name"
        android:layout_marginTop="5dp"
        android:text="Professor and Head"/>

</RelativeLayout>